# ─────────────────────────────────────────────────────────────
# Courser — Environment Variables
# Copia questo file come .env e compila i valori mancanti:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────


# ─── Database (PostgreSQL + Prisma) ─────────────────────────
# URL di connessione al database PostgreSQL.
# Locale (Docker): postgresql://postgres:postgres@localhost:5432/courser
# Supabase / Neon: fornitoti dal provider al momento del deploy
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/courser


# ─── NextAuth.js (Autenticazione) ───────────────────────────
# Genera un segreto con: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-secret

# URL base dell'app (di solito http://localhost:3000 in sviluppo)
NEXTAUTH_URL=http://localhost:3000


# ─── URL Pubblico (Checkout, Magic Link) ────────────────────
# Usato per generare URL assoluti nelle email e nei webhook
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ─── Google OAuth ───────────────────────────────────────────
# Crea un progetto su https://console.cloud.google.com/apis/credentials
# Abilita "OAuth 2.0" e configura l'URI di redirect:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─── Email SMTP (per Magic Link e NextAuth) ─────────────────
# Puoi usare SendGrid, Mailgun, Gmail SMTP, Resend, etc.
# Host: smtp.gmail.com | smtp.sendgrid.net | etc.
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Indirizzo mittente per le email inviate
EMAIL_FROM=noreply@tuodominio.com


# ─── Stripe (Pagamenti - Legacy) ────────────────────────────
# Opzionale: serve solo per ordini Stripe esistenti.
# I nuovi pagamenti usano Lemon Squeezy.
STRIPE_SECRET_KEY=sk_test_

# Segreto webhook: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_

# Chiave pubblica (NEXT_PUBLIC_* = visibile lato client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_


# ─── Lemon Squeezy (Pagamenti - Main) ───────────────────────
# Chiave API da Settings -> API: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=

# Store ID (lo trovi in Settings -> Stores)
LEMONSQUEEZY_STORE_ID=

# Webhook secret: impostalo in Settings -> Webhooks
# Puntalo a: https://tuodominio.com/api/webhooks/lemonsqueezy
# In locale: usa ngrok o stripe CLI (forward locale)
LEMONSQUEEZY_WEBHOOK_SECRET=


# ─── OpenAI (Traduzioni automatiche) ────────────────────────
# Chiave da https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-


# ─── Supabase (Storage / Auth alternativo) ──────────────────
# Opzionale: serve solo se usi Supabase per storage file
SUPABASE_URL=https://tuo-progetto.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
